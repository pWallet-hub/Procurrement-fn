# --- Docker (docker compose up -d --build) ---
# Port the web container is published on: http://localhost:${WEB_PORT}
WEB_PORT=8080
# Where nginx forwards /api. Can be ANY reachable API base (no path, no trailing slash):
#   http://host.docker.internal:3100   an API published on a port of this machine (default dev API)
#   http://host.docker.internal:3000   the default
#   http://api:3000                    a container named "api" on a shared docker network
#   https://procurement.example.org    a remote server
API_UPSTREAM=http://host.docker.internal:3000

# --- Browser / build ---
# API base used by the browser (same-origin by default; nginx / Vite proxy forward /api)
VITE_API_BASE=/api/v1

# --- Local dev (npm run dev) ---
# Dev server proxy target. Any API URL, e.g. the local dev API on port 3100
VITE_API_PROXY=http://localhost:3100

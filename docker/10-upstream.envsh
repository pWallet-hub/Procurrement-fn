#!/bin/sh
# Sourced by the nginx image entrypoint before the template is rendered.
# 1) default API_UPSTREAM, strip a trailing slash
# 2) NGINX_RESOLVER: first IPv4 nameserver from /etc/resolv.conf (docker's embedded DNS in a compose network)
# 3) nginx's resolver does not read /etc/hosts, but "extra_hosts: host.docker.internal:host-gateway" only lives there.
#    If the upstream host is a /etc/hosts entry we swap the name for its IP so the proxy still works.
API_UPSTREAM="${API_UPSTREAM:-http://host.docker.internal:3000}"
API_UPSTREAM="${API_UPSTREAM%/}"

NGINX_RESOLVER="$(awk '/^nameserver/ && $2 !~ /:/ {print $2; exit}' /etc/resolv.conf)"
NGINX_RESOLVER="${NGINX_RESOLVER:-127.0.0.11}"

_rest="${API_UPSTREAM#*://}"
_hostport="${_rest%%/*}"
_host="${_hostport%%:*}"
_port=""
case "$_hostport" in *:*) _port=":${_hostport##*:}" ;; esac
API_HOST="$_hostport"
_scheme="${API_UPSTREAM%%://*}"
_ip="$(awk -v h="$_host" '$1 !~ /^#/ { for (i = 2; i <= NF; i++) if ($i == h && $1 !~ /:/) { print $1; exit } }' /etc/hosts)"
if [ -n "$_ip" ] && [ "$_host" != "localhost" ]; then
  API_UPSTREAM="${_scheme}://${_ip}${_port}"
  echo "10-upstream: $_host is in /etc/hosts -> using $API_UPSTREAM"
fi
export API_UPSTREAM API_HOST NGINX_RESOLVER
echo "10-upstream: API_UPSTREAM=$API_UPSTREAM resolver=$NGINX_RESOLVER"
# reachability check at start: printed to the container log AND saved to /healthz/upstream.txt (readable in a browser), never blocks the start
_p="${_port#:}"
if [ -z "$_p" ]; then if [ "$_scheme" = "https" ]; then _p=443; else _p=80; fi; fi
_probe="$(wget -q -T 5 -O - "$API_UPSTREAM/api/v1/health" 2>&1 | head -c 300)"
_report="/usr/share/nginx/html/healthz-upstream.txt"
{
  echo "time:      $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "upstream:  $API_UPSTREAM  (Host header: $API_HOST)"
  echo "resolver:  $NGINX_RESOLVER"
  echo "dns:       $(nslookup "$_host" 2>&1 | awk '/^Name|^Address/ && !/#/ {printf "%s ", $0}' | head -c 300)"
  echo "tcp $_p:      $(nc -z -w 4 "$_host" "$_p" 2>&1 && echo open || echo "closed/blocked")"
  echo "http get:  ${_probe:-no response}"
} > "$_report" 2>/dev/null || true
case "$_probe" in
  *'"status":"ok"'*) echo "10-upstream: API reachable: $_probe" ;;
  *) echo "10-upstream: WARNING API NOT reachable at $API_UPSTREAM/api/v1/health -> ${_probe:-no response (DNS, firewall or wrong URL?)}" ;;
esac
